# Copy this file to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env

# --- Database ---
# These must match the credentials baked into your restored backup.
# Keep PG_USER=difedeapp and PG_DATABASE=difedeappv2 unless you also
# rewrite ownership inside the SQL dump.
PG_DATABASE=difedeappv2
PG_USER=difedeapp
PG_PASSWORD=change-me-to-a-strong-password

# --- Flask ---
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-64-char-hex-string

# --- Email (optional) ---
# Gmail app password for EMAIL_SENDER. Leave blank to disable email.
EMAIL_PASSWORD=
# Must be the same Gmail account that owns the app password.
EMAIL_SENDER=randjcoding@gmail.com
EMAIL_FROM_NAME=DiFede Games
# Public site URL used in email links (no trailing slash).
# Prod: https://games.difedes.com
# Local: http://localhost:5002
APP_BASE_URL=https://games.difedes.com

# --- Cloudflare Turnstile (bot protection on public forms) ---
# Create a widget in Cloudflare Turnstile (Managed mode is fine).
# Hostnames for this home stack typically include:
#   games.difedes.com   (Rocky live / tunnel)
#   www.difedes.com     (other Rocky site on same tunnel)
#   emmanuel.difedes.com
#   localhost           (Ubuntu local)
#   127.0.0.1           (Ubuntu local via loopback)
# Do NOT add ports (:5002). Do NOT add ccaweb if that site uses another account.
# Site key is public (HTML). Secret key is server-only — never commit real values.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Production compose only (Rocky / scaled deploy) ---
# REDIS_URL=redis://redis:6379/0
