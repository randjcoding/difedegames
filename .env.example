# Copy this file to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env

# --- Database ---
# These must match the credentials baked into your restored backup.
# Keep PG_USER=difedeapp and PG_DATABASE=difedeappv2 unless you also
# rewrite ownership inside the SQL dump.
PG_DATABASE=difedeappv2
PG_USER=difedeapp
PG_PASSWORD=change-me-to-a-strong-password

# --- Flask ---
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-64-char-hex-string

# --- Email (optional) ---
# Gmail app password used by app/email_utils.py. Leave blank to disable email.
EMAIL_PASSWORD=
